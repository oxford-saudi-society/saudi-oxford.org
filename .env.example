# Oxford Saudi Society — events system (Netlify Functions). Set these in Netlify → Site configuration →
# Environment variables (never commit real values). Local development: copy to .env and `export $(cat .env)`.

# Database (Netlify DB / Neon sets NETLIFY_DATABASE_URL automatically; any PostgreSQL 14+ works)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# DATABASE_SSL=verify            # verify (default for remote hosts) | require | no-verify | disable

# Sessions and one-time links are signed with this. 32+ random characters, e.g. `openssl rand -base64 48`
AUTH_SECRET=

# Public address of the site (used in emails and redirects). Netlify's URL variable is used when unset.
SITE_URL=https://ousss.org

# Email provider: Resend (https://resend.com). Domain must be verified there (SPF + DKIM) before sending.
RESEND_API_KEY=
MAIL_FROM="Oxford Saudi Society <events@ousss.org>"
MAIL_REPLY_TO=hello@ousss.org
# MAIL_PROVIDER=resend            # resend | log (queue only, nothing sent) — tests use capture/file

# First super admin(s): these addresses become super_admin on first sign-in (comma-separated)
ADMIN_BOOTSTRAP_EMAILS=

# Optional
# NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/…   # "Publish site" button in the desk
# SITE_API_URL=https://ousss.org                        # build reads live event state from the API
# WAITLIST_CLAIM_HOURS=24
# RETENTION_ENABLED=true          # anonymise attendee PII RETENTION_DAYS after each event (committee decision)
# RETENTION_DAYS=90
# PG_POOL_MAX=4
